{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synergy.node-readiness/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","readiness_id","profile_digest","source_lock_digest","build_plan_digest","service_specs","build_status","service_status","node_status","blockers","execution_authority","readiness_digest"],
  "properties": {
    "schema": {"const": "synergy.node-readiness/v1"},
    "readiness_id": {"type": "string", "minLength": 1},
    "profile_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_lock_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "build_plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "service_specs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service_id","repository","source_commit","service_spec_digest","readiness_status"],
        "properties": {
          "service_id": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "pattern": "^Shtenco/"},
          "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "service_spec_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "readiness_status": {"type": "string", "minLength": 1}
        }
      }
    },
    "build_status": {"type": "string", "minLength": 1},
    "service_status": {"type": "string", "minLength": 1},
    "node_status": {"type": "string", "minLength": 1},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "execution_authority": {"const": "NONE"},
    "readiness_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
