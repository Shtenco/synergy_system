{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"synergy.node-build-lock/v2",
  "type":"object","additionalProperties":false,
  "required":["schema","lock_id","profile_digest","capability_registry_digest","services","verification_status","execution_authority","lock_digest"],
  "properties":{
    "schema":{"const":"synergy.node-build-lock/v2"},
    "lock_id":{"type":"string","minLength":1},
    "profile_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "capability_registry_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "services":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["service_id","kind","repository","source_commit","source_ref","source_role","build_artifact_digest","build_evidence_digest","build_status"],"properties":{"service_id":{"type":"string","minLength":1},"kind":{"type":"string","pattern":"^[A-Z][A-Z0-9_]*$"},"repository":{"type":"string","pattern":"^Shtenco/[^/]+$"},"source_commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"source_ref":{"type":"string","minLength":1},"source_role":{"type":"string","pattern":"^[A-Z][A-Z0-9_]*$"},"build_artifact_digest":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},"build_evidence_digest":{"type":["string","null"],"pattern":"^[0-9a-f]{64}$"},"build_status":{"enum":["SOURCE_CANDIDATE_NOT_BUILD_VERIFIED","BUILD_ARTIFACT_FROZEN_TESTS_PENDING","BUILD_VERIFIED"]}}}},
    "verification_status":{"enum":["SOURCE_IDENTITY_FROZEN_BUILD_NOT_VERIFIED","BUILD_EVIDENCE_INCOMPLETE","BUILD_VERIFIED"]},
    "execution_authority":{"const":"NONE"},
    "lock_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
