{
  "$id": "https://synergy.local/schema/artifact_evidence_envelope_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "synergy.artifact-evidence-envelope/v1"},
    "envelope_id": {"minLength": 1, "type": "string"},
    "artifact_type": {"minLength": 1, "type": "string"},
    "artifact_schema": {"minLength": 1, "type": "string"},
    "artifact_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "source_repository": {"pattern": "^Shtenco/[^/]+$", "type": "string"},
    "source_commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "producer_repository": {"pattern": "^Shtenco/[^/]+$", "type": "string"},
    "authority_domain": {
      "enum": [
        "ARCHITECTURE_GOVERNANCE",
        "FINANCIAL_ACCOUNTING",
        "SETTLEMENT",
        "TRUST_COMMITMENT",
        "NETWORK_TRANSPORT",
        "RUNTIME_ORCHESTRATION",
        "HOST_EXECUTION",
        "AI_INFERENCE",
        "AI_PROPOSAL",
        "TRADING_PROPOSAL",
        "ENGINEERING_TRACE",
        "COMPRESSION_IDENTITY",
        "SCIENTIFIC_RESEARCH",
        "PUBLIC_TRACE_EVIDENCE",
        "DOMAIN_EVIDENCE",
        "CLIENT_PRESENTATION",
        "PRESENTATION_ONLY",
        "RESEARCH_ONLY",
        "NONE"
      ],
      "type": "string"
    },
    "authority_scope": {"const": "IDENTITY_AND_PROVENANCE_ONLY"},
    "environment": {
      "enum": [
        "LOCAL_TEST",
        "CI",
        "RESEARCH",
        "PREPRODUCTION",
        "STAGING",
        "LIVE_EXTERNAL",
        "PRODUCTION"
      ],
      "type": "string"
    },
    "evidence_status": {"const": "PROVENANCE_ENVELOPE_ONLY"},
    "source_status_text": {"minLength": 1, "type": "string"},
    "source_verifier_digest": {
      "oneOf": [
        {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        {"type": "null"}
      ]
    },
    "observed_at": {"pattern": "^.+Z$", "type": "string"},
    "parent_digests": {
      "items": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
      "maxItems": 64,
      "type": "array",
      "uniqueItems": true
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "artifact_path": {"minLength": 1, "type": "string"},
        "content_media_type": {"minLength": 1, "type": "string"},
        "human_label": {"minLength": 1, "type": "string"}
      },
      "required": ["artifact_path", "content_media_type", "human_label"],
      "type": "object"
    },
    "financial_authority": {"const": "NONE"},
    "payment_authority": {"const": "NONE"},
    "accounting_authority": {"const": "NONE"},
    "execution_authority": {"const": "NONE"},
    "signing_authority": {"const": "NONE"},
    "blockchain_submission_authority": {"const": "NONE"},
    "production_deployment_authority": {"const": "NONE"},
    "merge_authority": {"const": "NONE"},
    "envelope_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "required": [
    "schema",
    "envelope_id",
    "artifact_type",
    "artifact_schema",
    "artifact_digest",
    "source_repository",
    "source_commit",
    "producer_repository",
    "authority_domain",
    "authority_scope",
    "environment",
    "evidence_status",
    "source_status_text",
    "source_verifier_digest",
    "observed_at",
    "parent_digests",
    "metadata",
    "financial_authority",
    "payment_authority",
    "accounting_authority",
    "execution_authority",
    "signing_authority",
    "blockchain_submission_authority",
    "production_deployment_authority",
    "merge_authority",
    "envelope_digest"
  ],
  "title": "SYNERGY Artifact Evidence Envelope v1",
  "type": "object"
}