{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"synergy.capability-registry/v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","registry_id","generation","capabilities","service_kinds","authority_semantics"],
  "properties":{
    "schema":{"const":"synergy.capability-registry/v1"},
    "registry_id":{"const":"synergy-core-capabilities"},
    "generation":{"const":1},
    "capabilities":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["capability_id","authority_grant","risk_tier"],"properties":{"capability_id":{"type":"string","pattern":"^[A-Z][A-Z0-9_]*$"},"authority_grant":{"const":"NONE"},"risk_tier":{"enum":["LOW","MEDIUM","HIGH","CRITICAL"]}}}},
    "service_kinds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["kind","repository","required_capabilities"],"properties":{"kind":{"type":"string","pattern":"^[A-Z][A-Z0-9_]*$"},"repository":{"type":"string","pattern":"^Shtenco/[^/]+$"},"required_capabilities":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Z][A-Z0-9_]*$"}}}}},
    "authority_semantics":{"type":"object","additionalProperties":false,"required":["architecture_authority","runtime_manifest_authority","capability_does_not_grant_domain_authority","execution_authority"],"properties":{"architecture_authority":{"const":"Shtenco/synergy_system"},"runtime_manifest_authority":{"const":"Shtenco/synergy_meta_os"},"capability_does_not_grant_domain_authority":{"const":true},"execution_authority":{"const":"NONE"}}}
  }
}
