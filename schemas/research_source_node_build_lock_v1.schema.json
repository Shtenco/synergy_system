{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synergy.research-source-node-build-lock/v1",
  "title": "SYNERGY Research Source Node Build Lock v1 canonical profile",
  "description": "Canonical schema profile for the source-only synergy.node-build-lock/v1 shape implemented by node_build_lock_v1.py. The older synergy_node_build_lock_v1.schema.json is preserved as historical incompatible draft provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "lock_id",
    "profile_digest",
    "services",
    "verification_status",
    "execution_authority",
    "lock_digest"
  ],
  "properties": {
    "schema": {"const": "synergy.node-build-lock/v1"},
    "lock_id": {"const": "RESEARCH_COMPUTE_NODE_SOURCE_CANDIDATE_20260821"},
    "profile_digest": {"const": "406740705e853fa51ad4eacf7a01925fbe4b5cec491be35ea12ba777d217d714"},
    "services": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service_id",
          "repository",
          "source_commit",
          "source_ref",
          "source_role",
          "build_artifact_digest",
          "build_status"
        ],
        "properties": {
          "service_id": {"enum": ["content-cache", "nexus", "synergynet"]},
          "repository": {"type": "string", "pattern": "^Shtenco/[^/]+$"},
          "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "source_ref": {"type": "string", "minLength": 1},
          "source_role": {"type": "string", "minLength": 1},
          "build_artifact_digest": {"const": null},
          "build_status": {"const": "SOURCE_CANDIDATE_NOT_BUILD_VERIFIED"}
        }
      }
    },
    "verification_status": {"const": "SOURCE_IDENTITY_FROZEN_BUILD_NOT_VERIFIED"},
    "execution_authority": {"const": "NONE"},
    "lock_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
