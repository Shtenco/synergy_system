{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synergy.node-build-lock/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "node_profile_digest", "status", "components", "build_artifact_digest", "digest"],
  "properties": {
    "schema": {"const": "synergy.node-build-lock/v1"},
    "node_profile_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["SOURCE_CANDIDATE_NOT_BUILD_VERIFIED", "BUILD_VERIFIED"]},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service_id", "repository", "source_commit", "source_tree_digest", "verification_status"],
        "properties": {
          "service_id": {"type": "string", "minLength": 1},
          "repository": {"type": "string", "pattern": "^Shtenco/"},
          "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "source_tree_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "verification_status": {"enum": ["SOURCE_FROZEN", "BUILD_VERIFIED"]}
        }
      }
    },
    "build_artifact_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
