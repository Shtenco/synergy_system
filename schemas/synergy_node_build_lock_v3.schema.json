{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synergy.node-build-lock/v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "lock_id", "profile_digest", "capability_registry_digest", "services", "verification_status", "execution_authority", "lock_digest"],
  "properties": {
    "schema": {"const": "synergy.node-build-lock/v3"},
    "lock_id": {"const": "SCIENCE_RESEARCH_NODE_SOURCE_CANDIDATE_20260822"},
    "profile_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capability_registry_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "services": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["service_id", "kind", "repository", "source_commit", "source_ref", "source_role", "build_artifact_digest", "build_evidence_digest", "build_status"],
        "properties": {
          "service_id": {"enum": ["content-cache", "nexus", "science-agent", "synergynet"]},
          "kind": {"enum": ["CONTENT_CACHE", "NEXUS", "SCIENCE_AGENT", "SYNERGYNET"]},
          "repository": {"type": "string", "pattern": "^Shtenco/"},
          "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "source_ref": {"type": "string", "minLength": 1},
          "source_role": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "build_artifact_digest": {"type": "null"},
          "build_evidence_digest": {"type": "null"},
          "build_status": {"const": "SOURCE_CANDIDATE_NOT_BUILD_VERIFIED"}
        }
      }
    },
    "verification_status": {"const": "SOURCE_IDENTITY_FROZEN_BUILD_NOT_VERIFIED"},
    "execution_authority": {"const": "NONE"},
    "lock_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
