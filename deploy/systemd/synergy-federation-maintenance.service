[Unit]
Description=SYNERGY Federation Registry delegated-HSM verify/renew/rotate maintenance
Documentation=https://github.com/Shtenco/synergy_system
After=local-fs.target
ConditionPathExists=/etc/synergy/federation/federation-root.json
ConditionPathExists=/etc/synergy/federation/federation-registry.signed.json
ConditionPathExists=/etc/synergy/federation/registry-signer.certificate.json
ConditionPathExists=/etc/synergy/federation/registry-signer.revocations.json

[Service]
Type=oneshot
EnvironmentFile=/etc/synergy-federation-stack.env
EnvironmentFile=/etc/synergy-federation-hsm.env
Environment=PATH=/opt/synergy/venv/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStartPre=/usr/local/libexec/synergy-federation-preflight
ExecStartPre=/usr/local/libexec/synergy-federation-hsm-operator hsm-check
ExecStartPre=/usr/local/libexec/synergy-federation-hsm-operator verify
ExecStart=/usr/local/libexec/synergy-federation-hsm-operator maintain
ExecStartPost=/usr/local/libexec/synergy-federation-hsm-operator verify
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/etc/synergy/federation /var/lib/synergy/federation /run/secrets
ReadOnlyPaths=/opt/synergy /usr/local/libexec /etc/synergy-federation-stack.env /etc/synergy-federation-hsm.env

[Install]
WantedBy=multi-user.target
