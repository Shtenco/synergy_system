{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Shtenco/synergy_system/contracts/schemas/trading-validation-decision-v1.schema.json",
  "title": "Trading Validation Decision V1",
  "allOf": [
    {
      "$ref": "./event-envelope-v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "contract_id": {
          "const": "synergy.trading.validation-decision/v1"
        },
        "producer": {
          "const": "Shtenco/synergy_quantlab"
        },
        "authority": {
          "const": "trading_validation"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidate_event_id",
            "gate",
            "metrics",
            "protocol_id"
          ],
          "properties": {
            "candidate_event_id": {
              "type": "string",
              "format": "uuid"
            },
            "gate": {
              "enum": [
                "RESEARCH",
                "REJECT",
                "PAPER",
                "CANARY"
              ]
            },
            "protocol_id": {
              "type": "string",
              "minLength": 1
            },
            "dataset_manifest_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "metrics": {
              "type": "object",
              "required": [
                "n",
                "total_return",
                "sharpe",
                "max_drawdown",
                "hit_rate"
              ],
              "properties": {
                "n": {
                  "type": "integer",
                  "minimum": 0
                },
                "total_return": {
                  "type": "number"
                },
                "sharpe": {
                  "type": "number"
                },
                "max_drawdown": {
                  "type": "number",
                  "minimum": 0
                },
                "hit_rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ]
}