{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SYNERGY Archive Benchmark Evidence V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "benchmark_id",
    "target_sha256",
    "model_id16",
    "original_bytes",
    "container_bytes",
    "covered_bytes",
    "round_trip_verified",
    "temporal_cutoff_valid",
    "transport_reduction_percent",
    "deployment_authority"
  ],
  "properties": {
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "target_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_id16": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "original_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "container_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "covered_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "round_trip_verified": {
      "const": true
    },
    "temporal_cutoff_valid": {
      "const": true
    },
    "transport_reduction_percent": {
      "type": "number"
    },
    "deployment_authority": {
      "const": false
    }
  }
}
