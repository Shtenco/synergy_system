{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SYNERGY Trading Market Features V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "symbol",
    "window",
    "features",
    "authorization"
  ],
  "properties": {
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "window": {
      "type": "integer",
      "minimum": 1
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape",
        "mean",
        "std",
        "energy"
      ],
      "properties": {
        "shape": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "mean": {
          "type": "number"
        },
        "std": {
          "type": "number",
          "minimum": 0
        },
        "energy": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "authorization": {
      "const": false
    }
  }
}
