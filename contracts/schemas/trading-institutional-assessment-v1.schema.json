{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SYNERGY Trading Institutional Assessment V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "strategy_id",
    "symbol",
    "side",
    "confidence",
    "risk_estimate",
    "target_notional",
    "institutional_stage",
    "bounded_notional",
    "rationale",
    "timestamp",
    "authorization",
    "requires_canonical_risk_validation"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "strategy_id": {
      "type": "string",
      "minLength": 1
    },
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "side": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "risk_estimate": {
      "type": "number",
      "minimum": 0
    },
    "target_notional": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "institutional_stage": {
      "enum": [
        "RESEARCH",
        "VALIDATED",
        "RISK_APPROVED",
        "EXECUTION_READY",
        "BLOCKED"
      ]
    },
    "bounded_notional": {
      "type": "number",
      "minimum": 0
    },
    "rationale": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timestamp": {
      "type": "number"
    },
    "authorization": {
      "const": false
    },
    "requires_canonical_risk_validation": {
      "const": true
    }
  }
}
