{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SYNERGY Science Model Consistency V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "max_abs_error",
    "table_graph_gate_pass",
    "graph_nodes",
    "graph_edges",
    "epistemic_status",
    "assumptions",
    "observed_physical_effect",
    "causal_claim_authority"
  ],
  "properties": {
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "max_abs_error": {
      "type": "number",
      "minimum": 0
    },
    "table_graph_gate_pass": {
      "type": "boolean"
    },
    "graph_nodes": {
      "type": "integer",
      "minimum": 0
    },
    "graph_edges": {
      "type": "integer",
      "minimum": 0
    },
    "epistemic_status": {
      "enum": [
        "EVALUATED",
        "DERIVED",
        "HYPOTHESIS",
        "STRESS_TEST",
        "LEGACY"
      ]
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "observed_physical_effect": {
      "const": false
    },
    "causal_claim_authority": {
      "const": false
    }
  }
}
