{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SYNERGY Trading Fair Value V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "src",
    "dst",
    "fair_value",
    "max_hops",
    "authorization"
  ],
  "properties": {
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "src": {
      "type": "string",
      "minLength": 1
    },
    "dst": {
      "type": "string",
      "minLength": 1
    },
    "fair_value": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "max_hops": {
      "type": "integer",
      "minimum": 1
    },
    "authorization": {
      "const": false
    }
  }
}
