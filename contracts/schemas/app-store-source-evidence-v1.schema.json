{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SYNERGY App Store Source Evidence V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "app_id",
    "version",
    "android_gradle_sha256",
    "android_manifest_sha256",
    "ios_project_sha256",
    "ios_privacy_sha256",
    "source_verified",
    "artifact_built",
    "store_published",
    "deployment_authority"
  ],
  "properties": {
    "app_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "android_gradle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "android_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ios_project_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ios_privacy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_verified": {
      "const": true
    },
    "artifact_built": {
      "const": false
    },
    "store_published": {
      "const": false
    },
    "deployment_authority": {
      "const": false
    }
  }
}
