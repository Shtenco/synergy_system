{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Shtenco/synergy_system/contracts/schemas/event-envelope-v1.schema.json",
  "title": "SYNERGY Event Envelope V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "schema_version",
    "event_id",
    "trace_id",
    "producer",
    "authority",
    "produced_at",
    "payload",
    "payload_sha256",
    "evidence_ids",
    "parent_event_ids"
  ],
  "properties": {
    "contract_id": {
      "type": "string",
      "pattern": "^synergy\\.[a-z0-9_.-]+/v[1-9][0-9]*$"
    },
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "trace_id": {
      "type": "string",
      "format": "uuid"
    },
    "producer": {
      "type": "string",
      "pattern": "^Shtenco/[A-Za-z0-9_.-]+$"
    },
    "authority": {
      "type": "string",
      "minLength": 3
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^urn:synergy:evidence:[^:]+:[^:]+:sha256:[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "parent_event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "uniqueItems": true
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 8,
      "maxLength": 128
    },
    "state_version": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}