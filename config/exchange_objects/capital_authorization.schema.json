{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "synergy.exchange.CapitalAuthorization/v1",
  "title": "SYNERGY CapitalAuthorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "object_id",
    "created_at",
    "producer",
    "trace_id",
    "proposal_id",
    "currency",
    "amount",
    "authorized_by",
    "expires_at",
    "constraints"
  ],
  "properties": {
    "schema": {
      "const": "synergy.exchange.CapitalAuthorization/v1"
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposal_id": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "authorized_by": {
      "const": "synergy_financial_os"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "constraints": {
      "type": "object"
    }
  }
}
