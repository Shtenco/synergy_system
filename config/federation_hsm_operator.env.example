# ONLINE HSM SIGNING NODE ONLY. No Federation Root private key belongs here.
SYNERGY_FEDERATION_SOURCE=/opt/synergy/synergy_system/config/federation_trust_source_v1.json
SYNERGY_FEDERATION_ROOT_PUBLIC=/etc/synergy/federation/federation-root.json
SYNERGY_FEDERATION_SIGNER_PUBLIC=/etc/synergy/federation/registry-signer.public.json
SYNERGY_FEDERATION_SIGNER_CERT=/etc/synergy/federation/registry-signer.certificate.json
SYNERGY_FEDERATION_SIGNER_REVOCATIONS=/etc/synergy/federation/registry-signer.revocations.json
SYNERGY_FEDERATION_REGISTRY=/etc/synergy/federation/federation-registry.signed.json
SYNERGY_FEDERATION_NODE_SECRETS=/var/lib/synergy/federation/private/nodes
SYNERGY_FEDERATION_VERIFY_STATE=/var/lib/synergy/federation/state/registry-state.json

# PKCS#11 module/token. PIN must be a protected local file (0600) or vendor equivalent.
SHTTPS_PKCS11_MODULE=/usr/lib/vendor/libpkcs11.so
SHTTPS_PKCS11_TOKEN_LABEL=SYNERGY-FEDERATION
SHTTPS_PKCS11_KEY_LABEL=synergy-registry-signer-g1
SHTTPS_PKCS11_PIN_FILE=/run/secrets/synergy-pkcs11-pin

# Delegated signer policy: short registry lifetime, longer node lifetime.
SYNERGY_FEDERATION_REGISTRY_VALID_DAYS=7
SYNERGY_FEDERATION_NODE_VALID_DAYS=90
SYNERGY_FEDERATION_ROTATE_BEFORE_SECONDS=604800
SYNERGY_FEDERATION_REGISTRY_RENEW_BEFORE_SECONDS=172800
SYNERGY_FEDERATION_ROTATION_GRACE_SECONDS=3600
